---
const benefits = [
  {
    icon: "/icons/circle.svg",
    text: ["Duboko razumijevanje", "sebe i vlastitog puta"],
  },
  {
    icon: "/icons/eye.svg",
    text: ["Jasnoća, prisutnost", "i unutarnja snaga"],
  },
  {
    icon: "/icons/infinity.svg",
    text: ["Neprekinuti lanac", "prijenosa znanja"],
  },
  {
    icon: "/icons/horizon.svg",
    text: ["Praktični alati", "za svakodnevni život"],
  },
  {
    icon: "/icons/heart.svg",
    text: ["Zajednica i autentično", "dijeljenje"],
  },
  {
    icon: "/icons/target.svg",
    text: ["Iskustvo koje", "mijenja perspektivu"],
  },
];
---

<section class="benefits" aria-label="Vrijednosti škole NOvA">
  {
    benefits.map((benefit, index) => (
      <article class:list={["benefit", { divided: index !== 0 }]}>
        <img
          class="benefit-icon"
          src={benefit.icon}
          alt=""
          width="52"
          height="52"
          aria-hidden="true"
        />

        <p>
          <span>{benefit.text[0]}</span>
          <span>{benefit.text[1]}</span>
        </p>
      </article>
    ))
  }
</section>

<style>
  .benefits {
    width: 100%;
    height: 175px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    background: #fbfaf8;
  }

  .benefit {
    position: relative;
    min-width: 0;
    padding: 35px 18px 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .benefit.divided::before {
    content: "";
    position: absolute;
    top: 40px;
    bottom: 41px;
    left: 0;
    width: 1px;
    background: rgba(42, 38, 34, 0.12);
  }

  .benefit-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 13px;
    object-fit: contain;
  }

  p {
    margin: 0;
    color: #211f1d;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
  }

  p span {
    display: block;
  }

  @media (max-width: 1000px) {
    .benefits {
      height: auto;
      grid-template-columns: repeat(3, 1fr);
    }

    .benefit {
      min-height: 165px;
    }

    .benefit:nth-child(4)::before {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .benefits {
      grid-template-columns: repeat(2, 1fr);
    }

    .benefit {
      min-height: 155px;
      padding-inline: 12px;
    }

    .benefit::before {
      display: none;
    }

    .benefit-icon {
      width: 44px;
      height: 44px;
    }

    p {
      font-size: 13px;
    }
  }
</style>