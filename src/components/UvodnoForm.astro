<section class="uvodno-form-section" id="prijava">
  <div class="uvodno-form-section__inner">

    

    <form
      class="uvodno-form"
      action="https://formsubmit.co/nova.paradigma@yahoo.com"
      method="POST"
      accept-charset="UTF-8"
    >

      <input
        type="hidden"
        name="_subject"
        value="Prijava na uvodno predavanje NOvA – 21.10.2026."
      />

      <input
        type="hidden"
        name="_template"
        value="table"
      />

      <input
        type="hidden"
        name="_captcha"
        value="false"
      />

      <input
        type="hidden"
        name="_next"
        value="https://novaparadigma.hr/uvodno-predavanje/hvala/"
      />

      <input
        type="hidden"
        name="Vrsta obrasca"
        value="Uvodno predavanje – 21.10.2026."
      />

      <input
        class="uvodno-form__honey"
        type="text"
        name="_honey"
        tabindex="-1"
        autocomplete="off"
      />

      <div class="uvodno-form__field">
        <label for="uvodno-name">
          Ime i prezime
        </label>

        <input
          id="uvodno-name"
          name="Ime i prezime"
          type="text"
          autocomplete="name"
          placeholder="Vaše ime i prezime"
          required
        />
      </div>

      <div class="uvodno-form__field">
        <label for="uvodno-email">
          E-mail adresa
        </label>

        <input
          id="uvodno-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="Vaša e-mail adresa"
          required
        />
      </div>

      <label class="uvodno-form__privacy">
        <input type="checkbox" required />

        <span>
          Prihvaćam {" "}
          <a href="/pravila-privatnosti/" target="_blank">
            pravila privatnosti
          </a>.
        </span>
      </label>

      <button class="uvodno-form__button" type="submit">
        <span>Prijavi se na uvodno predavanje</span>
        <span class="uvodno-form__arrow" aria-hidden="true">⟶</span>
      </button>

    </form>

    <p class="uvodno-form-section__note">
      Zoom poveznicu primit ćete e-mailom prije predavanja.
    </p>

  </div>
</section>

