---
interface Props {
  title: string;
}

const { title } = Astro.props;

const icons: Record<string, string> = {
  "Tiha pažnja i duboko slušanje": "eye",
  "Širenje percepcije": "branch",
  "Snovi i svjesno prisustvo u snu": "moon",
  "Mapiranje automatizama": "person",
  "Rekapitulacija": "cycle",
  "Simboličko i arhetipsko čitanje": "star",

  "Rad s podsvjesnim blokadama": "circles",
  "Energetski pokreti": "waves",
  "Samosvjesni snovi i vizualizacije": "radiant-eye",
  "Oslobađanje emocija": "heart",
  "Unutarnja trijeznost": "sun",
  "Simboli i arhetipovi": "geometry",

  "Prisutnost u svakodnevici": "lotus",
  "Riječ i tišina": "speech",
  "Jasnoća u izborima i odnosima": "signpost",
  "Osobni rituali": "house",
  "Snovi i intuicija u životu": "horizon",
  "Samostalni put": "mountain",
};

const icon = icons[title] ?? "eye";
---

<span class="program-icon" aria-hidden="true">
  {
    icon === "eye" && (
      <svg viewBox="0 0 48 48">
        <path d="M7 25c4.8-7 10.6-10.5 17-10.5S36.2 18 41 25c-4.8 7-10.6 10.5-17 10.5S11.8 32 7 25Z" />
        <circle cx="24" cy="25" r="5.7" />
        <circle class="fill" cx="24" cy="25" r="1.5" />
        <path d="M11 11.5c4-2.8 8.4-4.2 13-4.2s9 1.4 13 4.2" />
      </svg>
    )
  }

  {
    icon === "branch" && (
      <svg viewBox="0 0 48 48">
        <path d="M15 42c4.2-13 10.2-23.5 19-34" />

        <path d="M20.5 31c-5.5.2-9.1-2.3-10.8-7.2 5.5-.2 9.1 2.2 10.8 7.2Z" />
        <path d="M25 24c.4-5.4 3.2-8.8 8.4-10.2-.3 5.3-3.1 8.8-8.4 10.2Z" />
        <path d="M17 37c-4.5.1-7.5-1.8-9-5.8 4.6-.2 7.6 1.7 9 5.8Z" />
        <path d="M29.5 17c.3-4.4 2.6-7.2 6.8-8.4-.2 4.3-2.5 7.1-6.8 8.4Z" />
      </svg>
    )
  }

  {
    icon === "moon" && (
      <svg viewBox="0 0 48 48">
        <path d="M29.5 7A17.5 17.5 0 1 0 30 41c-6.8-3.2-10.8-9-10.8-17S23 10.2 29.5 7Z" />
        <path d="M37 8v6M34 11h6" />
        <path d="M39 21v4M37 23h4" />
        <path d="M34 31v3M32.5 32.5h3" />
      </svg>
    )
  }

  {
    icon === "person" && (
      <svg viewBox="0 0 48 48">
        <circle cx="24" cy="13" r="7" />
        <path d="M11 41v-4.5C11 28.3 16.3 22 24 22s13 6.3 13 14.5V41H11Z" />
      </svg>
    )
  }

  {
    icon === "cycle" && (
      <svg viewBox="0 0 48 48">
        <path d="M10 21a15 15 0 0 1 25-7l3 3" />
        <path d="M38 10v7h-7" />

        <path d="M38 27a15 15 0 0 1-25 7l-3-3" />
        <path d="M10 38v-7h7" />
      </svg>
    )
  }

  {
    icon === "star" && (
      <svg viewBox="0 0 48 48">
        <path d="M24 5.5c1.4 10.6 4.9 16.7 14.5 18.5C28.9 25.8 25.4 31.9 24 42.5 22.6 31.9 19.1 25.8 9.5 24 19.1 22.2 22.6 16.1 24 5.5Z" />
      </svg>
    )
  }

  {
    icon === "circles" && (
      <svg viewBox="0 0 48 48">
        <circle cx="19" cy="18" r="9" />
        <circle cx="29" cy="18" r="9" />
        <circle cx="24" cy="28" r="9" />
      </svg>
    )
  }

  {
    icon === "waves" && (
      <svg viewBox="0 0 48 48">
        <path d="M7 13c4 0 4 2.5 8 2.5s4-2.5 8-2.5 4 2.5 8 2.5 4-2.5 8-2.5" />
        <path d="M7 23c4 0 4 2.5 8 2.5s4-2.5 8-2.5 4 2.5 8 2.5 4-2.5 8-2.5" />
        <path d="M7 33c4 0 4 2.5 8 2.5s4-2.5 8-2.5 4 2.5 8 2.5 4-2.5 8-2.5" />
      </svg>
    )
  }

  {
    icon === "radiant-eye" && (
      <svg viewBox="0 0 48 48">
        <path d="M7 25c4.8-7 10.6-10.5 17-10.5S36.2 18 41 25c-4.8 7-10.6 10.5-17 10.5S11.8 32 7 25Z" />
        <circle cx="24" cy="25" r="5.5" />
        <circle class="fill" cx="24" cy="25" r="1.4" />

        <path d="M24 5v5M24 40v4" />
        <path d="M9.5 10.5l3.5 3.5M35 36l3.5 3.5" />
        <path d="M38.5 10.5 35 14M13 36l-3.5 3.5" />
      </svg>
    )
  }

  {
    icon === "heart" && (
      <svg viewBox="0 0 48 48">
        <path d="M24 40C8.5 29.2 8.2 18.8 14.2 13.8a8.8 8.8 0 0 1 11.2 1.1L27 16.5l1.6-1.6a8.8 8.8 0 0 1 11.2-1.1C45.8 18.8 39.5 29.2 24 40Z" />
      </svg>
    )
  }

  {
    icon === "sun" && (
      <svg viewBox="0 0 48 48">
        <circle cx="24" cy="24" r="9" />

        <path d="M24 4v7M24 37v7" />
        <path d="M4 24h7M37 24h7" />
        <path d="M10 10l5 5M33 33l5 5" />
        <path d="M38 10l-5 5M15 33l-5 5" />
      </svg>
    )
  }

  {
    icon === "geometry" && (
      <svg viewBox="0 0 48 48">
        <circle cx="24" cy="24" r="17" />

        <path d="m24 7 10 6 7 11-7 11-10 6-10-6-7-11 7-11 10-6Z" />
        <path d="m24 7-4 10-6-4 3 11-10 0 10 5-3 6 10-3 10 3-3-6 10-5H31l3-11-6 4-4-10Z" />
        <path d="m17 24 7-7 7 7-7 8-7-8Z" />
      </svg>
    )
  }

  {
    icon === "lotus" && (
      <svg viewBox="0 0 48 48">
        <path d="M24 33c-7-5-10.5-11.2-10.5-18.5C19.8 16.8 23.3 21 24 27" />
        <path d="M24 33c7-5 10.5-11.2 10.5-18.5C28.2 16.8 24.7 21 24 27" />
        <path d="M24 33c-2-9.5-1-17.2 0-22 4.8 5.3 6.2 11.7 4.2 19" />
        <path d="M21 30c-5.8-6.3-11-8.2-15.5-7.5C8.2 30.8 14.3 35 24 35" />
        <path d="M27 30c5.8-6.3 11-8.2 15.5-7.5C39.8 30.8 33.7 35 24 35" />
        <path d="M12 39h24" />
      </svg>
    )
  }

  {
    icon === "speech" && (
      <svg viewBox="0 0 48 48">
        <path d="M7 11h20a5 5 0 0 1 5 5v9a5 5 0 0 1-5 5H17l-7 6v-6H7a5 5 0 0 1-5-5v-9a5 5 0 0 1 5-5Z" />
        <path d="M30 18h11a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5h-3v5l-6-5h-4" />
      </svg>
    )
  }

  {
    icon === "signpost" && (
      <svg viewBox="0 0 48 48">
        <path d="M23 7v35" />
        <path d="M23 11h14l-4 5 4 5H23Z" />
        <path d="M23 24H10l4 5-4 5h13Z" />
        <path d="M18 42h10" />
      </svg>
    )
  }

  {
    icon === "house" && (
      <svg viewBox="0 0 48 48">
        <path d="M7 22 24 9l17 13v19H7V22Z" />
        <path d="M18 41V27h12v14" />
        <path d="M11 21v-7h6" />
      </svg>
    )
  }

  {
    icon === "horizon" && (
      <svg viewBox="0 0 48 48">
        <path d="M14 28a10 10 0 0 1 20 0" />
        <path d="M8 28h32" />
        <path d="M12 34h24" />
        <path d="M17 40h14" />

        <path d="M24 7v7" />
        <path d="m11 13 5 5M37 13l-5 5" />
        <path d="M6 22h7M35 22h7" />
      </svg>
    )
  }

  {
    icon === "mountain" && (
      <svg viewBox="0 0 48 48">
        <path d="M5 39 19 17l7 10 5-7 12 19H5Z" />
        <path d="m16 22 3-5 3.5 5" />
        <path d="m27.5 25 3.5-5 4 6" />
      </svg>
    )
  }
</span>

<style>
  .program-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    color: #a87854;
  }

  .program-icon svg {
    display: block;
    width: 44px;
    height: 44px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .program-icon .fill {
    fill: currentColor;
    stroke: none;
  }
</style>