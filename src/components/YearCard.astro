---
interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  bullets?: string[];
  icon: "eye" | "cycle" | "target";
}

const {
  number,
  title,
  paragraphs,
  bullets = [],
  icon,
} = Astro.props;
---

<article class="year-card">
  <div class="year-heading">
    <span class="year-number">{number}.</span>
    <h2>{title}</h2>
  </div>

  <span class="year-line" aria-hidden="true"></span>

  <div class="year-content">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

    {
      bullets.length > 0 && (
        <ul>
          {bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      )
    }
  </div>

  <div class="year-icon" aria-hidden="true">
    {
      icon === "eye" && (
        <svg viewBox="0 0 64 40" fill="none">
          <path d="M6 20Q18 6 32 6Q46 6 58 20Q46 34 32 34Q18 34 6 20Z" />
          <circle cx="32" cy="20" r="8" />
          <circle cx="32" cy="20" r="1.8" fill="currentColor" stroke="none" />
        </svg>
      )
    }

    {
  icon === "cycle" && (
    <svg viewBox="0 0 64 64" fill="none">

      <circle
        cx="32"
        cy="32"
        r="24"
      />

      <!-- freccia superiore -->
      <path d="M24 27
               C27 21 37 21 40 27" />
      <path d="M37.5 23.5
               L40.8 27
               L36 28" />

      <!-- freccia inferiore -->
      <path d="M40 37
               C37 43 27 43 24 37" />
      <path d="M26.5 40.5
               L23.2 37
               L28 36" />

    </svg>
  )
}

    {
      icon === "target" && (
        <svg viewBox="0 0 64 64" fill="none">
          <circle cx="32" cy="32" r="20" />
          <circle cx="32" cy="32" r="12" />
          <circle cx="32" cy="32" r="4" />
        </svg>
      )
    }
  </div>
</article>

<style>
  .year-card {
    min-height: 430px;
    padding: 0 38px 28px;

    display: flex;
    flex-direction: column;
  }

  .year-heading {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .year-number {
    color: #a97853;
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: 500;
    line-height: 1;
  }

  h2 {
    margin: 0;

    color: #2c2926;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .year-line {
    display: block;
    width: 34px;
    height: 1px;
    margin: 12px 0 18px;

    background: #b68b68;
  }

  .year-content {
    color: #2d2925;
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }

  .year-content p {
    margin: 0 0 16px;
  }

  ul {
    margin: 0 0 16px;
    padding-left: 18px;
  }

  li {
    margin-bottom: 3px;
  }

  li::marker {
    color: #a97853;
  }

  .year-icon {
    width: 48px;
    margin-top: auto;

    color: #a97853;
  }

  .year-icon svg {
    width: 100%;
    height: auto;

    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 900px) {
    .year-card {
      min-height: auto;
      padding: 34px 0;
    }

    .year-icon {
      margin-top: 12px;
    }
  }
</style>