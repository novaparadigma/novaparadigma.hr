---
import HeroContent from "./HeroContent.astro";
import HeroImage from "./HeroImage.astro";
---

<section class="hero">
  <HeroImage />

  <div class="hero-container">
    <HeroContent />
  </div>
</section>

<style>
  .hero,
  .hero * {
    box-sizing: border-box;
  }

  .hero {
    position: relative;
    width: 100%;
    height: 575px;
    overflow: hidden;
    background: #24201c;
  }

  .hero-container {
    position: relative;
    z-index: 2;

    width: min(1358px, calc(100% - 120px));
    height: 100%;
    margin: 0 auto;

    display: flex;
    align-items: center;
  }

  @media (max-width: 1200px) {
    .hero-container {
      width: calc(100% - 96px);
    }
  }

  @media (max-width: 700px) {
    .hero {
      height: auto;
      min-height: 730px;
    }

    .hero-container {
      width: calc(100% - 40px);
      min-height: 730px;
      padding: 115px 0 42px;

      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 700px;
    }

    .hero-container {
      width: calc(100% - 34px);
      min-height: 700px;
      padding: 96px 0 34px;
    }
  }
</style>