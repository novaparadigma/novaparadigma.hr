---
const enrollmentOpen = true;
---
<section class="schedule-top">
  <section class="schedule-hero">
    <img
      class="schedule-hero__image"
      src="/images/sections/raspored-main.webp"
      alt="Jezero, planine i drveni mol u svjetlu zalaska sunca"
    />

    <div class="schedule-hero__overlay"></div>

    <div class="schedule-hero__container">
      <div class="schedule-hero__content">
        <p class="schedule-eyebrow">RASPORED I CIJENE</p>

        <h1>
          Put počinje<br />
          kada odlučiš<br />
          uložiti u sebe.
        </h1>

        <span class="schedule-hero__line"></span>

        {
  enrollmentOpen ? (
    <a
      class="schedule-hero__note schedule-hero__note--link"
      href="/kontakt"
      aria-label="Pridružite se programu NOvA"
    >
      <span class="schedule-hero__leaf" aria-hidden="true">
        <svg viewBox="0 0 46 46">
          <path d="M17 42c3.3-12.7 8.3-23.5 17-35" />
          <path d="M22 30c-5.2.2-8.7-2.1-10.5-6.8 5.3-.3 8.8 2 10.5 6.8Z" />
          <path d="M27 22c.3-5.1 3-8.4 8-9.8-.2 5.1-2.9 8.3-8 9.8Z" />
          <path d="M18 37c-4.4.1-7.3-1.8-8.7-5.8 4.4-.1 7.3 1.8 8.7 5.8Z" />
          <path d="M31 15c.2-4.1 2.3-6.8 6.2-8-.1 4.1-2.2 6.8-6.2 8Z" />
        </svg>
      </span>

      <p>Upisi u tijeku.</p>
    </a>
  ) : (
    <div class="schedule-hero__note">
      <span class="schedule-hero__leaf" aria-hidden="true">
        <svg viewBox="0 0 46 46">
          <path d="M17 42c3.3-12.7 8.3-23.5 17-35" />
          <path d="M22 30c-5.2.2-8.7-2.1-10.5-6.8 5.3-.3 8.8 2 10.5 6.8Z" />
          <path d="M27 22c.3-5.1 3-8.4 8-9.8-.2 5.1-2.9 8.3-8 9.8Z" />
          <path d="M18 37c-4.4.1-7.3-1.8-9.2-5.9 4.7-.2 7.7 1.8 9.2 5.9Z" />
          <path d="M31 15c.2-4.1 2.3-6.8 6.2-8-.1 4.1-2.2 6.8-6.2 8Z" />
        </svg>
      </span>

      <p>Prvi korak počinje odlukom.</p>
    </div>
  )
}
      </div>
    </div>
  </section>

  <section class="schedule-overview">
    <div class="schedule-overview__inner">
      <header class="schedule-section-title">
        <span class="schedule-section-title__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <rect x="8" y="11" width="32" height="29" rx="2" />
            <path d="M15 7v8M33 7v8M8 19h32" />
            <path d="M15 25h4M24 25h4M33 25h1" />
            <path d="M15 32h4M24 32h4M33 32h1" />
          </svg>
        </span>

        <h2>Raspored</h2>
      </header>

      <div class="schedule-dates">
        <article class="schedule-date">
          <div class="schedule-date__icon" aria-hidden="true">
            <svg viewBox="0 0 54 54">
              <path d="m8 19 19-10 19 10-19 10L8 19Z" />
              <path d="M15 24v11c7 5 17 5 24 0V24" />
              <path d="M46 19v15" />
              <circle cx="46" cy="37" r="2" />
            </svg>
          </div>

          <div class="schedule-date__content">
            <h3>1. godina</h3>

            <p>
              Nastava počinje <strong>15.10.2026.</strong><br />
              i traje do <strong>10.06.2027.</strong>
            </p>
          </div>
        </article>

        <article class="schedule-date">
          <div class="schedule-date__icon" aria-hidden="true">
            <svg viewBox="0 0 54 54">
              <path d="m8 19 19-10 19 10-19 10L8 19Z" />
              <path d="M15 24v11c7 5 17 5 24 0V24" />
              <path d="M46 19v15" />
              <circle cx="46" cy="37" r="2" />
            </svg>
          </div>

          <div class="schedule-date__content">
            <h3>2. godina</h3>

            <p>
              Nastava počinje <strong>14.10.2026.</strong><br />
              i traje do <strong>09.06.2027.</strong>
            </p>
          </div>
        </article>

        <article class="schedule-date schedule-date--time">
          <div class="schedule-date__icon" aria-hidden="true">
            <svg viewBox="0 0 54 54">
              <circle cx="27" cy="27" r="18" />
              <path d="M27 15v13l8 6" />
            </svg>
          </div>

          <div class="schedule-date__content">
            <h3>Predavanja</h3>

            <p>
              Dva puta mjesečno —<br />
              srijedom ili četvrtkom<br />
              od <strong>20:00 do 22:00.</strong>
            </p>
          </div>
        </article>
      </div>

      <article class="schedule-structure">
        <div class="schedule-structure__illustration">
          <img
            src="/images/sections/raspored-structure-illustration.webp"
            alt="Planinski krajolik s borovima i stazom"
          />
        </div>

        <div class="schedule-structure__content">
          <h2>Struktura programa</h2>

          <p>
            Osnovni program podijeljen je u tri akademske godine.
          </p>

          <p>
            Nakon završetka treće godine, putovanje se može nastaviti kroz
            cikluse naprednih predavanja, rezervirane isključivo za one koji
            su prošli put tri akademske godine.
          </p>
        </div>
      </article>
    </div>
  </section>
</section>

<style>
  .schedule-top {
    background: #f7f1e9;
    color: #292521;
  }

  /* HERO */

  .schedule-hero {
    position: relative;
    min-height: 565px;
    overflow: hidden;
  }

  .schedule-hero__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .schedule-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(15, 15, 14, 0.9) 0%,
      rgba(15, 15, 14, 0.72) 30%,
      rgba(15, 15, 14, 0.3) 56%,
      rgba(15, 15, 14, 0.02) 100%
    );
  }

  .schedule-hero__container {
    position: relative;
    z-index: 2;
    width: min(1332px, calc(100% - 120px));
    min-height: 565px;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .schedule-hero__content {
    width: min(100%, 465px);
    padding: 58px 0;
    color: #f9f4ed;
  }

  .schedule-eyebrow {
    margin: 0 0 20px;
    font-family: "Inter", sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #c49268;
  }

  .schedule-hero h1 {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(50px, 5.1vw, 72px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #fffaf3;
  }

  .schedule-hero__line {
    display: block;
    width: 55px;
    height: 1px;
    margin: 31px 0 25px;
    background: #bc8c64;
  }

  .schedule-hero__note {
    display: flex;
    align-items: center;
    gap: 18px;
    color: #c99a72;
  }

  .schedule-hero__note p {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: 27px;
    line-height: 1.2;
  }

  .schedule-hero__note--link {
  width: fit-content;
  text-decoration: none;
  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.schedule-hero__note--link:hover {
  color: #e0b58e;
  transform: translateX(4px);
}

  .schedule-hero__leaf {
    display: block;
    width: 38px;
    height: 38px;
  }

  .schedule-hero__leaf svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* RASPORED */

  .schedule-overview {
    padding: 42px 60px 57px;
  }

  .schedule-overview__inner {
    width: min(100%, 1332px);
    margin: 0 auto;
  }

  .schedule-section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 23px;
    margin-bottom: 36px;
  }

  .schedule-section-title__icon {
    display: block;
    width: 39px;
    height: 39px;
    color: #a97852;
  }

  .schedule-section-title__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .schedule-section-title h2 {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: 37px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .schedule-dates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 38px;
  }

  .schedule-date {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 22px;
    align-items: center;
    min-height: 126px;
    padding: 0 34px;
    border-right: 1px solid rgba(114, 85, 62, 0.17);
  }

  .schedule-date:first-child {
    padding-left: 22px;
  }

  .schedule-date:last-child {
    padding-right: 22px;
    border-right: 0;
  }

  .schedule-date__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: #eee3d6;
    color: #966b4c;
  }

  .schedule-date__icon svg {
    display: block;
    width: 54px;
    height: 54px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .schedule-date__content h3 {
    margin: 0 0 12px;
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .schedule-date__content p {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    line-height: 1.45;
    color: #403832;
  }

  .schedule-date__content strong {
    font-weight: 600;
    color: #8d603f;
  }

  /* STRUKTURA PROGRAMA */

  .schedule-structure {
    display: grid;
    grid-template-columns: minmax(310px, 0.92fr) minmax(440px, 1.6fr);
    min-height: 218px;
    overflow: hidden;
    border: 1px solid rgba(151, 111, 78, 0.14);
    border-radius: 8px;
    background: #eee4d8;
  }

  .schedule-structure__illustration {
    min-width: 0;
    min-height: 218px;
    overflow: hidden;
    background: #eee4d8;
  }

  .schedule-structure__illustration img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.99;
    mix-blend-mode: multiply;
  }

  .schedule-structure__content {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 34px 55px 34px 42px;
    background: #eee4d8;
  }

  .schedule-structure__content h2 {
    margin: 0 0 14px;
    font-family: "Cormorant Garamond", serif;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .schedule-structure__content p {
    margin: 0 0 14px;
    max-width: 770px;
    font-family: "Cormorant Garamond", serif;
    font-size: 19px;
    line-height: 1.48;
    color: #403832;
  }

  .schedule-structure__content p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 1100px) {
    .schedule-hero__container {
      width: calc(100% - 72px);
    }

    .schedule-overview {
      padding-inline: 36px;
    }

    .schedule-dates {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .schedule-date,
    .schedule-date:first-child,
    .schedule-date:last-child {
      padding: 0 0 28px;
      border-right: 0;
      border-bottom: 1px solid rgba(114, 85, 62, 0.17);
    }

    .schedule-date:last-child {
      border-bottom: 0;
    }

    .schedule-structure {
      grid-template-columns: 1fr;
    }

    .schedule-structure__illustration {
      min-height: 300px;
    }

    .schedule-structure__content {
      padding: 34px 40px 42px;
    }
  }

  @media (max-width: 700px) {
    .schedule-hero {
      min-height: 660px;
    }

    .schedule-hero__image {
      object-position: 66% center;
    }

    .schedule-hero__overlay {
      background: linear-gradient(
        90deg,
        rgba(15, 15, 14, 0.92) 0%,
        rgba(15, 15, 14, 0.72) 72%,
        rgba(15, 15, 14, 0.35) 100%
      );
    }

    .schedule-hero__container {
      width: calc(100% - 40px);
      min-height: 660px;
      padding: 10px 0 42px;
      align-items: flex-start;
    }

    .schedule-hero__content {
      padding: 90px 0 52px;
    }

    .schedule-hero h1 {
      font-size: 49px;
    }

    .schedule-hero__note p {
      font-size: 24px;
    }

    .schedule-overview {
      padding: 36px 20px 45px;
    }

    .schedule-section-title {
      gap: 16px;
    }

    .schedule-section-title h2 {
      font-size: 30px;
    }

    .schedule-date {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 18px;
    }

    .schedule-date__icon {
      width: 68px;
      height: 68px;
    }

    .schedule-date__icon svg {
      width: 44px;
      height: 44px;
    }

    .schedule-date__content p {
      font-size: 17px;
    }

    .schedule-structure__illustration {
      min-height: 220px;
    }

    .schedule-structure__content {
      padding: 30px 24px 36px;
    }

    .schedule-structure__content h2 {
      font-size: 24px;
    }

    .schedule-structure__content p {
      font-size: 18px;
    }
  }
</style>