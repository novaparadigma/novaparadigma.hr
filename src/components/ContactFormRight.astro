<article class="nova-right">
  <header class="nova-right__heading">
    <span class="nova-right__number" aria-hidden="true">
      2.
    </span>

    <div class="nova-right__heading-text">
      <h2>Imaš pitanje?</h2>

      <p>Nisi siguran ili želiš saznati nešto više? Piši nam.</p>

      <span class="nova-right__heading-line" aria-hidden="true"></span>
    </div>
  </header>

  <form
    class="nova-right__form"
    action="https://formsubmit.co/nova.paradigma@yahoo.com"
    method="POST"
    accept-charset="UTF-8"
  >
    <!-- FormSubmit postavke -->
    <div class="nova-right__hidden-fields" aria-hidden="true">
      <input
        type="hidden"
        name="_subject"
        value="Nova poruka sa stranice NOvA"
      />

      <input
        type="hidden"
        name="_template"
        value="table"
      />

      <input
        type="hidden"
        name="_captcha"
        value="false"
      />

      <input
        type="hidden"
        name="Vrsta obrasca"
        value="Pitanje o školi ili programu"
      />

      <input
        type="text"
        name="_honey"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="nova-right__field">
      <label for="nova-question-name">
        Ime
      </label>

      <input
        id="nova-question-name"
        name="Ime"
        type="text"
        autocomplete="name"
        placeholder="Unesite vaše ime"
        required
      />
    </div>

    <div class="nova-right__field">
      <label for="nova-question-email">
        E-mail
      </label>

      <input
        id="nova-question-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="Unesite e-mail adresu"
        required
      />
    </div>

    <div class="nova-right__field">
      <label for="nova-question-message">
        Poruka
      </label>

      <textarea
        id="nova-question-message"
        name="Poruka"
        rows="6"
        placeholder="Napiši svoje pitanje..."
        required
      ></textarea>
    </div>

    <button class="nova-right__button" type="submit">
      <span>Pošalji poruku</span>

      <span class="nova-right__button-arrow" aria-hidden="true">
        ⟶
      </span>
    </button>
  </form>

  <aside class="nova-right__info">
<div class="nova-right__chat" aria-hidden="true">
  <svg
    viewBox="0 0 64 56"
    role="presentation"
    focusable="false"
  >
    <path
      class="nova-right__bubble"
      d="
        M32 6
        C47 6 58 15 58 27
        C58 39 47 48 32 48
        C28 48 24 47 21 46
        L10 52
        L13 41
        C7 37 4 32 4 27
        C4 15 16 6 32 6
        Z
      "
    />

    <path
      class="nova-right__bubble-lines"
      d="
        M18 24H46
        M18 31H39
      "
    />
  </svg>
</div>

    <div class="nova-right__info-content">
      <h3>Slobodno pitaj.</h3>

      <p>
        Tu smo da ti pomognemo osjetiti je li NOvA pravi korak za tebe.
      </p>
    </div>
  </aside>
</article>

