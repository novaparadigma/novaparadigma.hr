---
import YearCard from "./YearCard.astro";

const years: Array<{
  number: string;
  title: string;
  paragraphs: string[];
  bullets?: string[];
  icon: "eye" | "cycle" | "target";
}> = [
  {
    number: "1",
    title: "Promatrati",
    paragraphs: [
      "Prva godina posvećena je učenju promatranja.",
      "Kroz praktične vježbe i svakodnevne eksperimente razvija se nova kvaliteta pažnje koja omogućuje jasnije promatranje sebe, drugih i života.",
      "Što učimo promatrati:",
    ],
    bullets: [
      "misli",
      "emocije",
      "reakcije",
      "obrasce koje svakodnevno živimo, a da ih često ni ne primjećujemo",
    ],
    icon: "eye",
  },
  {
    number: "2",
    title: "Transformirati",
    paragraphs: [
      "Kada počnemo jasnije vidjeti, prirodno se pojavljuje mogućnost promjene. Obrasci koji su nas do tada vodili postupno gube svoju snagu jer ih sve jasnije prepoznajemo.",
      "Transformacija postaje prirodna posljedica tog procesa.",
      "Što učimo prepoznavati i oslobađati:",
    ],
    bullets: [
      "automatske obrasce",
      "misli i emocije",
      "simbolički jezik iskustva",
      "svakodnevne životne situacije",
    ],
    icon: "cycle",
  },
  {
    number: "3",
    title: "Integrirati",
    paragraphs: [
      "Treća godina nije završetak. Ona označava trenutak kada ono što smo učili postaje način života.",
      "Znanje prestaje biti nešto čega se prisjećamo. Postaje način na koji promatramo, biramo i živimo.",
      "Kako se to odražava u svakodnevnom životu:",
    ],
    bullets: [
      "u odnosima",
      "u odlukama",
      "u radu",
      "u načinu na koji živimo svakodnevicu",
    ],
    icon: "target",
  },
];
---

<section class="put-years">
  <div class="put-years-inner">
    {years.map((year) => <YearCard {...year} />)}
  </div>
</section>

<style>
  .put-years {
    padding: 20px 0 34px;
    background: #f6f1e9;
  }

  .put-years-inner {
    width: min(1332px, calc(100% - 136px));
    margin-inline: auto;

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .put-years-inner :global(.year-card + .year-card) {
    border-left: 1px solid rgba(80, 66, 54, 0.16);
  }

  @media (max-width: 900px) {
    .put-years {
      padding: 10px 0 30px;
    }

    .put-years-inner {
      width: calc(100% - 56px);
      grid-template-columns: 1fr;
    }

    .put-years-inner :global(.year-card + .year-card) {
      border-top: 1px solid rgba(80, 66, 54, 0.16);
      border-left: 0;
    }
  }

  @media (max-width: 600px) {
    .put-years-inner {
      width: calc(100% - 40px);
    }
  }
</style>