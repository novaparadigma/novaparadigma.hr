<article class="nova-left">
  <header class="nova-left__heading">
    <span class="nova-left__number" aria-hidden="true">
      1.
    </span>

    <div class="nova-left__heading-text">
      <h2>Želim se upisati</h2>

      <p>Prijava za školsku godinu 2026./2027.</p>

      <span class="nova-left__heading-line" aria-hidden="true"></span>
    </div>
  </header>

  <form
    class="nova-left__form"
    action="https://formsubmit.co/nova.paradigma@yahoo.com"
    method="POST"
    accept-charset="UTF-8"
  >
    <!-- FormSubmit postavke -->
    <div class="nova-left__hidden-fields" aria-hidden="true">
      <input
        type="hidden"
        name="_subject"
        value="Nova prijava za školu NOvA"
      />

      <input
        type="hidden"
        name="_template"
        value="table"
      />

      <input
        type="hidden"
        name="_captcha"
        value="false"
      />

      <input
        type="hidden"
        name="Vrsta obrasca"
        value="Prijava za školu NOvA"
      />

      <input
        type="text"
        name="_honey"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="nova-left__field">
      <label for="nova-application-name">
        Ime i prezime
      </label>

      <input
        id="nova-application-name"
        name="Ime i prezime"
        type="text"
        autocomplete="name"
        placeholder="Unesite vaše ime i prezime"
        required
      />
    </div>

    <div class="nova-left__field">
      <label for="nova-application-email">
        E-mail
      </label>

      <input
        id="nova-application-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="Unesite e-mail adresu"
        required
      />
    </div>

    <div class="nova-left__field">
      <label for="nova-application-phone">
        Mobitel
      </label>

      <input
        id="nova-application-phone"
        name="Broj mobitela"
        type="tel"
        autocomplete="tel"
        placeholder="Unesite broj mobitela"
      />
    </div>

    <label class="nova-left__checkbox">
      <input
        type="checkbox"
        name="Želim se upisati"
        value="Da"
        required
      />

      <span
        class="nova-left__checkbox-box"
        aria-hidden="true"
      ></span>

      <span class="nova-left__checkbox-text">
        Želim se upisati u školu NOvA.
      </span>
    </label>

    <button class="nova-left__button" type="submit">
      <span>Prijavi se</span>

      <span class="nova-left__button-arrow" aria-hidden="true">
        ⟶
      </span>
    </button>
  </form>

  <aside class="nova-left__info">
    <div class="nova-left__calendar" aria-hidden="true">
      <svg
        viewBox="0 0 48 48"
        role="presentation"
        focusable="false"
      >
        <rect
          x="8"
          y="11"
          width="32"
          height="29"
          rx="1.5"
        ></rect>

        <path d="M15 6V16"></path>
        <path d="M33 6V16"></path>
        <path d="M8 20H40"></path>

        <path d="M15.5 27H19"></path>
        <path d="M23 27H26.5"></path>
        <path d="M30.5 27H34"></path>

        <path d="M15.5 34H19"></path>
        <path d="M23 34H26.5"></path>
      </svg>
    </div>

    <div class="nova-left__info-content">
      <h3>Što slijedi?</h3>

      <ul>
        <li>
          <span class="nova-left__check" aria-hidden="true">
            ✓
          </span>

          <span>Javit ćemo ti se u roku od 48 sati.</span>
        </li>

        <li>
          <span class="nova-left__check" aria-hidden="true">
            ✓
          </span>

          <span>Odgovorit ćemo na sva pitanja.</span>
        </li>

        <li>
          <span class="nova-left__check" aria-hidden="true">
            ✓
          </span>

          <span>
            Nakon upisa dobit ćeš pristup svim materijalima i grupama.
          </span>
        </li>
      </ul>
    </div>
  </aside>
</article>

